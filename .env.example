# Copy to .env and adjust. Every value here has a development-safe default,
# so the file is optional for local work.

# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite. For PostgreSQL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/product_api
DATABASE_URL=

# Requests per minute
DJANGO_THROTTLE_ANON=60/min
DJANGO_THROTTLE_USER=240/min
DJANGO_THROTTLE_PURCHASE=10/min

DJANGO_ACCESS_TOKEN_MINUTES=30
DJANGO_REFRESH_TOKEN_DAYS=1

DJANGO_LOG_LEVEL=INFO

# Production only
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_CSRF_TRUSTED_ORIGINS=
